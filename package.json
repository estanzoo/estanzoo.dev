{
  "name": "estanzoo.dev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:related": "vitest related --run",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "og": "node scripts/og.mjs",
    "pins:update": "PINS_UPDATE=1 vitest run --project unit src/testing/pins.test.ts",
    "screens": "tools/worktree-env.sh >/dev/null && node tools/screens/cli.mjs serve",
    "screens:list": "node tools/screens/cli.mjs list",
    "screens:render": "node tools/screens/cli.mjs render",
    "screens:renderAll": "node tools/screens/cli.mjs renderAll"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "parse5": "^8.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
